---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout 
  title="HVAC Blog | Tips for Phoenixville Homeowners"
  description="Practical HVAC tips, maintenance advice, and repair guidance for Phoenixville and Chester County homeowners."
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> → Blog</div>
      <h1>HVAC Tips &amp; Guides</h1>
      <p>Practical advice to keep your Phoenixville home comfortable and your system running efficiently.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="problems-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="problem-card" style="display:block">
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <p style="margin-top:0.75rem;font-size:0.9rem;color:var(--text-muted)">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
